import javax.swing.*;
import java.awt.*;

/**
 * Panel for brewing potions from known recipes, letting the player pick a
 * recipe from a list and brew it or return to the main dashboard.
 */

public class RecipeBrewInterface extends JPanel {

	private static final long serialVersionUID = 1L;

	private JList<String> recipeList;
	private DefaultListModel<String> recipeListModel;
	private JButton btnBrewSelectedRecipe;
	private JButton btnExitRecipeBrew;

/**
* Create the panel.
* Builds the title label, scrollable recipe list, and the brew/back buttons.
*/
	
	public RecipeBrewInterface() {
		
		setLayout(null);
		setSize(588, 450);

		JLabel lblTitle = new JLabel("--- BREW CONCOCTION : RECIPE MODE ---");
		lblTitle.setHorizontalAlignment(SwingConstants.CENTER);
		lblTitle.setFont(new Font("Lucida Grande", Font.PLAIN, 18));
		lblTitle.setBounds(50, 20, 488, 25);
		add(lblTitle);

		recipeListModel = new DefaultListModel<>();
		recipeList = new JList<>(recipeListModel);
		JScrollPane scrollPane = new JScrollPane(recipeList);
		scrollPane.setBounds(50, 60, 488, 260);
		add(scrollPane);

		btnBrewSelectedRecipe = new JButton("Brew Selected Recipe");
		btnBrewSelectedRecipe.setBounds(50, 347, 200, 51);
		add(btnBrewSelectedRecipe);

		btnExitRecipeBrew = new JButton("Back to Main Menu");
		btnExitRecipeBrew.setBounds(338, 347, 200, 51);
		add(btnExitRecipeBrew);

	}

// Returns the "Brew Selected Recipe" button
	
	public JButton getBtnBrewSelectedRecipe() {
		return this.btnBrewSelectedRecipe;
	}

// Returns the "Back to Main Menu" button
	
	public JButton getBtnExitRecipeBrew() {
		return this.btnExitRecipeBrew;
	}

// Returns the JList displaying available recipes
	
	public JList<String> getRecipeList() {
		return this.recipeList;
	}

// Returns the list model backing the recipe list
	
	public DefaultListModel<String> getRecipeListModel() {
		return this.recipeListModel;
	}

}
