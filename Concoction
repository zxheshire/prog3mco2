/**
* Concoction class represents a brewed potion
* and the logic for brewing it either from a chosen
* recipe or from a freely chosen base/fruit combination
* authors: Marie Valle
* version 1.0
* since 2026
*/

package MCO2.model;

import java.util.*;

import MCO2.controller.*;

public class Concoction {

	private int concoctionID;
	private String name;
	private int sellPrice;

// Create an empty, unbrewed concoction
	
	public Concoction()
	{
		this.concoctionID = 0;
		this.name = "";
		this.sellPrice = 0;
	}

// Create a concoction pre-filled with the given recipe's ID, name, and sell price
	
	public Concoction(Recipe recipe) {
		if (recipe != null) {
			this.concoctionID =	recipe.getConcoctionID();
			this.name = recipe.getPotionName();
			this.sellPrice = recipe.getSellingPrice();
		}
	}

/**
* Brews the given recipe if the player has all required ingredients:
* consumes the base and fruits from inventory, sets this concoction's
* fields to the recipe's values, credits the player with the sell price,
* and increments the market's brew count.
*/
	
	public boolean recipeMode(Player p, Market marketInstance, Recipe targetRecipe) {
		if(targetRecipe == null) return false;
		
		String baseNeeded = targetRecipe.getBase().getName();
		ArrayList<String> fruitsNeeded = targetRecipe.getFruits();
		Inventory inv = p.getInventory();
		
		if(inv.getUsableCauldronsCount() < 1) {
			System.out.println("You have no usable cauldrons to brew with!");
			return false;
		}
		
		if(inv.getIngredientQty(baseNeeded) < 1) return false;
		for(String fruit : fruitsNeeded) {
			if(inv.getIngredientQty(fruit) < 1) return false;
		}
		
		if(inv.getIngredientQty(baseNeeded) >= 1) {
			for(int i = 0; i < inv.getItems().length; i++) {
				if(inv.getItems()[i] != null && inv.getItems()[i].getIngredient().getIngredientName().equalsIgnoreCase(baseNeeded)) {
					inv.removeIngredient(i, 1);
					break;
				}
			}
		}
		
		for(String targetFruit : fruitsNeeded) {
			for(int i = 0; i < inv.getItems().length; i++) {
				if(inv.getItems()[i] != null && inv.getItems()[i].getIngredient().getIngredientName().equalsIgnoreCase(targetFruit)) {
					inv.removeIngredient(i, 1);
					break;
				}
			}
		}
		inv.compactInventory();
		
		this.concoctionID = targetRecipe.getConcoctionID();
		this.name = targetRecipe.getPotionName();
		this.sellPrice = targetRecipe.getSellingPrice();
		
		p.addCrystals(this.sellPrice);
		
		marketInstance.incrementBrewCount();
		
		return true;
		
	}

/**
* Attempts a freeform brew: consumes the chosen base and fruits from the
* player's inventory if available, then checks the recipe database for a
* matching recipe. On a match, updates this concoction's fields, credits
* the player, and unlocks the recipe in their spellbook. On no match,
* breaks one of the player's cauldrons instead
*/
	
	public Recipe creativeMode(Player p, RecipeDatabase db, String baseName, Market marketInstance, ArrayList<String> chosenFruits) {
		Inventory inv = p.getInventory();
		
		if(inv.getUsableCauldronsCount() < 1) {
			System.out.println("You have no usable cauldrons to brew with!");
			return null;
		}
		
		if(inv.getIngredientQty(baseName) < 1) return null;
		for (String f :chosenFruits) {
			if(inv.getIngredientQty(f) < 1) return null;
		}
		
		for(int i = 0; i < inv.getItems().length; i++) {
			if(inv.getItems()[i] != null && inv.getItems()[i].getIngredient().getIngredientName().equalsIgnoreCase(baseName)) {
				inv.removeIngredient(i, 1);
				break;
			}
		}
		
		for(String f : chosenFruits) {
			for(int i = 0; i < inv.getItems().length; i++) {
				if(inv.getItems()[i] != null && inv.getItems()[i].getIngredient().getIngredientName().equalsIgnoreCase(f)) {
					inv.removeIngredient(i, 1);
					break;
				}
			}
		}
		inv.compactInventory();
		
		ConcoctionBase chosenBaseObj = new ConcoctionBase(baseName);
		Recipe matchedBlueprint = db.validateMix(chosenBaseObj, chosenFruits);
		
		if(matchedBlueprint != null) {
			this.concoctionID = matchedBlueprint.getConcoctionID();
			this.name = matchedBlueprint.getPotionName();
			this.sellPrice = matchedBlueprint.getSellingPrice();
			
			p.addCrystals(this.sellPrice);
			p.getSpellbook().addRecipe(matchedBlueprint);
			
			return matchedBlueprint;
		}else {
			p.breakCauldron();
			return null;
		}
		
	}

// Returns the concoction's ID
	
	public int getConcoctionID() {
		return concoctionID;
	}

// Returns the concoction's name
	
	public String getName() {
		return name;
	}

// Returns the concoction's sell price
	
	public int getSellPrice() {
		return sellPrice;
	}
}
