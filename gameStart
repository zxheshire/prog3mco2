	/**Initializes a new game controller session.
	 * Sets up the input scanner, marks the game state as running, 
	 * and loads blank database and market instances.
	 */
	
	public gameStart() {
		this.recipeDB = new RecipeDatabase();
		this.primaryMarket = new Market();
	}
	
	/**
	 * Loads the master recipe database from an external CSV file.
	 * @param csvPath  is the file path
	 */
	
	public void initializeRecipes(String csvPath) {
		this.recipeDB.loadPCcsv(csvPath);
	}
	
	/* Displays the welcome screen and handles the primary entry choices 
	 * to either start a brand new game session or restore an old one.
	 */
	
