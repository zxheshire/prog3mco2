	private void setupCreativeBrewView() {
		this.welcomeView.getCreativeBrewCard().getBtnCreativeBrewConcoction().addActionListener(new ActionListener() {
			@Override
			public void actionPerformed(ActionEvent e) {
				
				MCO2.view.CreativeBrewInterface creativeCard = welcomeView.getCreativeBrewCard();
				String chosenBase = creativeCard.getComboBaseSelection().getSelectedItem().toString();
				ArrayList<String> selectedFruits = creativeCard.getSelectedFruitsList();
				
				if(p.getInventory().getUsableCauldronsCount() < 2) {
					JOptionPane.showMessageDialog(welcomeView, "You have no usable cauldrons to brew potions. Please bless a cauldron first.", "Brew Restriction", JOptionPane.WARNING_MESSAGE);
					return;
				}
				
				if(selectedFruits.isEmpty()) {
					JOptionPane.showMessageDialog(welcomeView, "Please select 1-3 unique fruit check boxes to brew.", "Selection Error", JOptionPane.WARNING_MESSAGE);
					return;
				}
				
				MCO2.model.Concoction logicEngine = new MCO2.model.Concoction();
				Recipe discoveredRecipe = logicEngine.creativeMode(p, recipeDB, chosenBase, primaryMarket, selectedFruits);
				
				if(discoveredRecipe != null) {
					primaryMarket.incrementBrewCount();
					refreshDashboardView();
					
					JOptionPane.showMessageDialog(welcomeView, "Successfully brewed [" + discoveredRecipe.getPotionName() + "] | Recipe ID: #" + discoveredRecipe.getConcoctionID(), "Brew Success", JOptionPane.INFORMATION_MESSAGE);
					}else {
						
						if(p.getInventory().getIngredientQty(chosenBase) < 1) {
							JOptionPane.showMessageDialog(welcomeView, "Failed to brew. You do not have enough [" + chosenBase + "] in your inventory.", "Brew Failure", JOptionPane.ERROR_MESSAGE);
							
						}else {
							
								primaryMarket.incrementBrewCount();
								refreshDashboardView();
								JOptionPane.showMessageDialog(welcomeView, "oh no! The potion fizzled up and turned into slop,,,,,\nYour cauldron was ruined and is filled with waste", "Cauldron Waste", JOptionPane.ERROR_MESSAGE);
							
						}
					}
				
				JOptionPane.showMessageDialog(welcomeView, "You have " + p.getInventory().getUsableCauldronsCount() + " usable cauldrons remaining.", "Cauldron Status", JOptionPane.INFORMATION_MESSAGE);
				welcomeView.showDashboardPage();
			}
		});
	}
	
	private void setupRecipeBrewView() {

	    welcomeView.getRecipeBrewCard().getBtnBrewSelectedRecipe().addActionListener(new ActionListener() {
	        @Override
	        public void actionPerformed(ActionEvent e) {

	            if (p.getInventory().getUsableCauldronsCount() < 2) {
	                JOptionPane.showMessageDialog(welcomeView, "You have no usable cauldrons to brew potions. Please bless a cauldron first.", "Brew Restriction", JOptionPane.WARNING_MESSAGE);
	                return;
	            }

	            int selectionIndex = welcomeView.getRecipeBrewCard().getRecipeList().getSelectedIndex();
	            ArrayList<Recipe> unlockedRecipes = p.getSpellbook().getRecipeSorted();

	            if (selectionIndex < 0 || selectionIndex >= unlockedRecipes.size()) {
	                JOptionPane.showMessageDialog(welcomeView, "Please select a recipe to brew.", "Selection Error", JOptionPane.WARNING_MESSAGE);
	                return;
	            }

	            Recipe selectedRecipe = unlockedRecipes.get(selectionIndex);

	            MCO2.model.Concoction logicEngine = new MCO2.model.Concoction();
	            boolean brewSuccess = logicEngine.recipeMode(p, primaryMarket, selectedRecipe);

	            if (brewSuccess) {
	                primaryMarket.incrementBrewCount();
	                refreshDashboardView();
	                JOptionPane.showMessageDialog(welcomeView, "Successfully brewed [" + selectedRecipe.getPotionName() + "]", "Brew Success", JOptionPane.INFORMATION_MESSAGE);
	            } else {
	                JOptionPane.showMessageDialog(welcomeView, "Failed to brew [" + selectedRecipe.getPotionName() + "]. Check your inventory for required ingredients.", "Brew Failure", JOptionPane.ERROR_MESSAGE);
	            }

	            JOptionPane.showMessageDialog(welcomeView, "You have " + p.getInventory().getUsableCauldronsCount() + " usable cauldrons remaining.", "Cauldron Status", JOptionPane.INFORMATION_MESSAGE);
	            welcomeView.showDashboardPage();
	        }
	    });
	}

