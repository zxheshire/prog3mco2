	private void setupBrewConcoctionButton() {
		this.welcomeView.getBtnBrewConcoction().addActionListener(new ActionListener() {
			@Override
			public void actionPerformed(ActionEvent e) {
				
				if(p.getInventory().getUsableCauldronsCount() < 2) {
					JOptionPane.showMessageDialog(welcomeView, "You have no usable cauldrons to brew potions. Please bless a cauldron first.", "Brew Restriction", JOptionPane.WARNING_MESSAGE);
					return;
				}
				
				String[] options = {"Recipe Mode","Creative Mode", "Cancel"};
				int modeSelection = JOptionPane.showOptionDialog(welcomeView, "Select a brewing mode:", "Brew Mode Selection", JOptionPane.DEFAULT_OPTION, JOptionPane.QUESTION_MESSAGE, null, options, options);
				
				if(modeSelection == 0) {
				
					RecipeBrewInterface rbCard = welcomeView.getRecipeBrewCard();
					rbCard.getRecipeListModel().clear();
					
					ArrayList<Recipe> unlockedRecipes = p.getSpellbook().getRecipeSorted();
					
					if(unlockedRecipes.isEmpty()) {
						JOptionPane.showMessageDialog(welcomeView,"No recipes discovered. Try brewing some potions in creative mode first!","Recipe Registry", JOptionPane.WARNING_MESSAGE);
					}else {
						for(Recipe r : unlockedRecipes) {
							rbCard.getRecipeListModel().addElement(String.format("[ID: # %d] %s (Base: %s | Fruits: %s)", r.getConcoctionID(), r.getPotionName(), r.getBase().getName(), r.getFruits().toString()));
						}
					}
					
					welcomeView.showRecipeBrewPage();
				} else if(modeSelection == 1) {
					welcomeView.getCreativeBrewCard().resetCheckboxes();
					welcomeView.showCreativeBrewPage();
				}
			}
		});
	}
	
