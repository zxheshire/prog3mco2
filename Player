/**
* Player class holds information regarding
* the player itself: the name, crystals,
* inventory, spellbook, and login bonus
* authors: Marie Valle
* version 1.0
* since 2026
*/

package MCO2.model;

import java.io.*;
import java.util.*;

public class Player {
	private String name;
	private int crystals;
	private Inventory inventory;
	private Spellbook spellbook;
	private boolean claimedLogInBonus;
	
/**
* Create a new player with the given name, starting crystals, and empty
* inventory/spellbook
*/
	
	public Player(String name) {
		this.name = name;
		this.crystals = 5000;
		this.inventory = new Inventory();
		this.spellbook = new Spellbook();
		this.claimedLogInBonus = false;
	}


// Returns the player's name

	
	public String getName() {
		return this.name;
	}

// Sets the player's name, trimming whitespace, if it's non-null and non-blank

	public void setName(String name) {
		if(name != null && !name.trim().isEmpty()) {
			this.name = name.trim();
		}
	}

// Returns the player's current crystal balance

	public int getCrystals() {
		return this.crystals;
	}

// Sets the player's crystal balance directly

	public void setCrystals(int crystals) {
		this.crystals = crystals;
	}

// Adds crystals to the player's balance if the amount is positive

	public void addCrystals(int amt) {
		if(amt>0) {
			this.crystals += amt;
		}
	}

/**
* Deducts crystals if the player can afford it.
* @param amt
* @return true if the deduction succeeded, false if amt was invalid
* or the player didn't have enough crystals
*/

	public boolean deductCrystals(int amt) {
		if(amt > 0 && this.crystals >= amt) {
			this.crystals -= amt;
			return true;
		}
		return false;
	}

/**
* Marks the first usable cauldron in the player's inventory as unusable
* (broken). Does nothing if no usable cauldron is found.
*/

	public void breakCauldron() {
		Cauldron[] cauldronArray = this.getInventory().getCauldrons();
		boolean cauldronBroken = false;
		
		for(int i = 0; i < cauldronArray.length; i++) {
			if(cauldronArray[i] != null && cauldronArray[i].isUsable()) {
				cauldronArray[i].setUsable(false);
				cauldronBroken = true;
				
				System.out.println("A cauldron has been ruined and is full of slop!");
				break;
			}
		}
		
		if(!cauldronBroken) {
			System.out.println("You have no more usable cauldrons");
		}
	}
	
// Returns the player's spellbook

	public Spellbook getSpellbook() {
		return this.spellbook;
	}

// Returns the player's inventory

	public Inventory getInventory(){
		return this.inventory;
	} 

// Returns whether the player has already claimed the login bonus

	public boolean hasClaimedBonus() {
		return this.claimedLogInBonus;
	}

//  Sets whether the player has claimed the login bonus

	public void setClaimedBonus(boolean claimed) {
		this.claimedLogInBonus = claimed;
	}
	
}
