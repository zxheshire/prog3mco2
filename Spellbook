package MCO2.model;

import java.util.*;

/**
* Tracks which potion recipes a player has unlocked
*/

public class Spellbook {
	private ArrayList<Recipe> unlockedRecipes;

// Create an empty spellbook with no unlocked recipes
	
	public Spellbook() {
		
		this.unlockedRecipes = new ArrayList<>();
	
	}

// Adds the given recipe to the spellbook if it isn't already unlocked
	
	public void addRecipe(Recipe recipe) {
	
		if(recipe != null && !isRecipeUnlocked(recipe.getConcoctionID())) {
			this.unlockedRecipes.add(recipe);
			System.out.println("Added new recipe");
		}
		
	}

// Returns a copy of the unlocked recipes, sorted ascending by concoction ID
	
	public ArrayList <Recipe> getRecipeSorted(){
		
		ArrayList<Recipe> sortedList = new ArrayList<>(this.unlockedRecipes);
		
		java.util.Collections.sort(sortedList, new Comparator<Recipe>(){
			@Override
			public int compare (Recipe r1, Recipe r2) {
				return Integer.compare(r1.getConcoctionID(), r2.getConcoctionID());
			}
		});
		
		return sortedList;
	}

// Returns true if a recipe with the given concoction ID is already unlocked
	
	public boolean isRecipeUnlocked (int targetID) {
		
		for(Recipe r : this.unlockedRecipes) {
			if(r.getConcoctionID() == targetID) {
				return true;
			}
		}
		return false;
	}

// Returns true if no recipes have been unlocked yet
	
	public boolean isEmpty() {
		return this.unlockedRecipes.isEmpty();
	}
	
}
