package MCO2.view;

import javax.swing.*;

import java.awt.*;

public class WelcomeInterface extends JFrame {

	private static final long serialVersionUID = 1L;
	
	private CardLayout cardLayout;
	private JPanel mainContainerPanel;

// starting page

	private JPanel welcomePagePanel;
	private JButton btnNewGame;
	private JButton btnLoadGame;

// dashboard / main menu

	private JPanel dashboardPagePanel;
	private JLabel lblPlayerStatus;
	private JButton btnBrewConcoction;
	private JButton btnCheckInventory;
	private JButton btnCheckSpellbook;
	private JButton btnVisitMarket;
	private JButton btnBlessCauldron;
	private JButton btnLoginBonus;
	private JButton btnExitGame;
	
//spellbook

	private SpellbookInterface spellbookCard;
	
//brew

	private RecipeBrewInterface recipeBrewCard;
	private CreativeBrewInterface creativeBrewCard;

//For market Interface

	private MarketInterface marketView;
	private BuyView buyView;
	private SellView sellView;
	
//For inventory Interface

	private InventoryInterface inventoryView;
	
//for bless cauldron interface

	private BlessCauldronView blessView;
	
/**
* Create the frame.
* Sets up the window and builds the welcome and dashboard panels
* then registers all cards with the CardLayout container
*/

	public WelcomeInterface() {
		setTitle("Potion Prodigy");
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setBounds(100, 100, 588, 450);
		setLocationRelativeTo(null);
		
		cardLayout = new CardLayout();
		mainContainerPanel = new JPanel(cardLayout);
		setContentPane(mainContainerPanel);
		
		//spellbook
		
		try {
			spellbookCard = new SpellbookInterface();
		} catch (Exception npe) {
			spellbookCard = new SpellbookInterface();
		}
		
		mainContainerPanel.add(spellbookCard, "SPELLBOOK_PAGE");
		
		//brew
		
		recipeBrewCard = new RecipeBrewInterface();
		creativeBrewCard = new CreativeBrewInterface();
		
		mainContainerPanel.add(recipeBrewCard, "RECIPE_BREW_PAGE");
		mainContainerPanel.add(creativeBrewCard, "CREATIVE_BREW_PAGE");
		
		//page1
		
		welcomePagePanel = new JPanel();
		welcomePagePanel.setLayout(null);
		
		JLabel lblTitle = new JLabel("Welcome to Potion Prodigy!");
		lblTitle.setFont(new Font("Lucida Grande", Font.PLAIN, 30));
		lblTitle.setBounds(97, 30, 411, 47);
		welcomePagePanel.add(lblTitle);
		
		btnLoadGame = new JButton("Load Game");
		btnLoadGame.setBounds(213, 199, 177, 70);
        welcomePagePanel.add(btnLoadGame);
        
        btnNewGame = new JButton("New Game");
		btnNewGame.setBounds(213, 106, 177, 70);
        welcomePagePanel.add(btnNewGame);

        mainContainerPanel.add(welcomePagePanel, "WELCOME_PAGE");
        
        // page2

        dashboardPagePanel = new JPanel();
        dashboardPagePanel.setLayout(null);

        lblPlayerStatus = new JLabel("Welcome to the Main Menu!");
        lblPlayerStatus.setHorizontalAlignment(SwingConstants.CENTER);
        lblPlayerStatus.setFont(new Font("Lucida Grande", Font.PLAIN, 20));
        lblPlayerStatus.setBounds(67, 28, 452, 20);
        dashboardPagePanel.add(lblPlayerStatus);

        btnBrewConcoction = new JButton("Brew Concoction");
        btnBrewConcoction.setBounds(217, 88, 150, 30);
        dashboardPagePanel.add(btnBrewConcoction);

        btnCheckInventory = new JButton("Check Inventory");
        btnCheckInventory.setBounds(217, 130, 150, 30);
        dashboardPagePanel.add(btnCheckInventory);

        btnCheckSpellbook = new JButton("Check Spellbook");
        btnCheckSpellbook.setBounds(217, 172, 150, 30);
        dashboardPagePanel.add(btnCheckSpellbook);
        
        btnVisitMarket = new JButton("Visit Market");
        btnVisitMarket.setBounds(217, 214, 150, 30);
        dashboardPagePanel.add(btnVisitMarket);
        
        btnBlessCauldron = new JButton("Bless Cauldron");
        btnBlessCauldron.setBounds(217, 256, 150, 30);
        dashboardPagePanel.add(btnBlessCauldron);
        
        btnLoginBonus = new JButton("Login Bonus");
        btnLoginBonus.setBounds(217, 298, 150, 30);
        dashboardPagePanel.add(btnLoginBonus);
        
        btnExitGame = new JButton("Exit Game");
        btnExitGame.setBounds(217, 340, 150, 30);
        dashboardPagePanel.add(btnExitGame);
        
        mainContainerPanel.add(dashboardPagePanel, "DASHBOARD_PAGE");
        
        cardLayout.show(mainContainerPanel, "WELCOME_PAGE");
    }

// Switches the CardLayout to show the welcome page 
	
	public void showWelcomePage() {
		if(this.cardLayout != null && this.mainContainerPanel != null) {
			// Show the welcome page
			cardLayout.show(this.mainContainerPanel, "WELCOME_PAGE");
		}
	}

// Switches the CardLayout to show the dashboard / main menu page and refreshes it
	
	public void showDashboardPage() {
		if(this.cardLayout != null && this.mainContainerPanel != null) {
			// Show the dashboard page
			cardLayout.show(this.mainContainerPanel, "DASHBOARD_PAGE");
			this.mainContainerPanel.revalidate();
			this.mainContainerPanel.repaint();
		}
	}

// Switches the CardLayout to show the spellbook page and refreshes it
	
	public void showSpellbookPage() {
		if(this.cardLayout != null && this.mainContainerPanel != null) {
			// Show the spellbook page
			cardLayout.show(mainContainerPanel, "SPELLBOOK_PAGE");
			this.mainContainerPanel.revalidate();
			this.mainContainerPanel.repaint();
		}
	}

// Switches the CardLayout to show the recipe brew page and refreshes it
	
	public void showRecipeBrewPage() {
		if(this.cardLayout != null && this.mainContainerPanel != null) {
			// Show the recipe brew page
			cardLayout.show(mainContainerPanel, "RECIPE_BREW_PAGE");
			this.mainContainerPanel.revalidate();
			this.mainContainerPanel.repaint();
		}
	}

// Switches the CardLayout to show the creative brew page and refreshes it
	
	public void showCreativeBrewPage() {
		if(this.cardLayout != null && this.mainContainerPanel != null) {
			// Show the creative brew page
			cardLayout.show(mainContainerPanel, "CREATIVE_BREW_PAGE");
			this.mainContainerPanel.revalidate();
			this.mainContainerPanel.repaint();
		}
	}

// Returns the spellbook card/panel instance
	
	public SpellbookInterface getSpellbookCard() {
		return this.spellbookCard;
	}

// Returns the recipe brew card/panel instance
	
	public RecipeBrewInterface getRecipeBrewCard() {
		return this.recipeBrewCard;
	}

// Returns the creative brew card/panel instance
	
	public CreativeBrewInterface getCreativeBrewCard() {
		return this.creativeBrewCard;
	}

// For Market Interface
// Switches the CardLayout to show the market page

	public void showMarketView() {
	    cardLayout.show(mainContainerPanel, "MARKET_PAGE");
	}

// Returns the market view instance
	
	public MarketInterface getMarketView() {
	    return marketView;
	}
	
// For Market Buy Ingredients Interface
// Creates the buy view for the given market and registers it with the CardLayout

	public void createBuyView(Market market) {
	    buyView = new BuyView(market);
	    mainContainerPanel.add(buyView, "BUY_PAGE");
	}

// Reloads market data and switches the CardLayout to show the buy page
	
	public void showBuyView() {
	    buyView.loadMarket();
	    cardLayout.show(mainContainerPanel, "BUY_PAGE");
	}

// Returns the buy view instance

	public BuyView getBuyView() {
	    return buyView;
	}
	
// For Market Sell Ingredients Interface
// Creates the sell view for the given market and registers it with the CardLayout

	public void createSellView(Market market) {
	    sellView = new SellView(market);
	    mainContainerPanel.add(sellView, "SELL_PAGE");
	}

// Reloads inventory data and switches the CardLayout to show the sell page
	
	public void showSellView() {
	    sellView.loadInventory();
	    cardLayout.show(mainContainerPanel, "SELL_PAGE");
	}

// Returns the sell view instance

	public SellView getSellView() {
	    return sellView;
	}
	
// For Inventory Interface
// Creates the inventory view and registers it with the CardLayout

	public void createInventoryView() {
	    inventoryView = new InventoryInterface();
	    mainContainerPanel.add(inventoryView, "INVENTORY_PAGE");
	}

// Reloads inventory data and switches the CardLayout to show the inventory page

	public void showInventoryView() {
	    inventoryView.loadInventory();
	    cardLayout.show(mainContainerPanel, "INVENTORY_PAGE");
	}

// Returns the inventory view instance

	public InventoryInterface getInventoryView() {
	    return inventoryView;
	}
	
// For Bless Cauldron Interface
// Creates the bless cauldron view and registers it with the CardLayout

		public void createBlessView() {
			blessView = new BlessCauldronView();
		    mainContainerPanel.add(blessView, "BLESS_CAULDRON_PAGE");
		}

// Reloads inventory data and switches the CardLayout to show the bless cauldron page

		public void showBlessView() {
		    blessView.loadInventory();
		    cardLayout.show(mainContainerPanel, "BLESS_CAULDRON_PAGE");
		}

// Returns the bless cauldron view instance

		public BlessCauldronView getBlessView() {
		    return blessView;
		}

// Returns the "New Game" button

	public JButton getBtnNewGame() {
		return this.btnNewGame;
	}

// Returns the "Load Game" button
	
	public JButton getBtnLoadGame() {
		return this.btnLoadGame;
	}

// Returns the "Brew Concoction" button
	
	public JButton getBtnBrewConcoction() {
		return this.btnBrewConcoction;
	}

// Returns the "Check Inventory" button
	
	public JButton getBtnCheckInventory() {
		return this.btnCheckInventory;
	}

// Returns the "Check Spellbook" button
	
	public JButton getBtnCheckSpellbook() {
		return this.btnCheckSpellbook;
	}

// Returns the "Visit Market" button
	
	public JButton getBtnVisitMarket() {
		return this.btnVisitMarket;
	}

// Returns the "Bless Cauldron" button
	
	public JButton getBtnBlessCauldron() {
		return this.btnBlessCauldron;
	}

// Returns the "Login Bonus" button
	
	public JButton getBtnLoginBonus() {
		return this.btnLoginBonus;
	}

// Returns the "Exit Game" button
	
	public JButton getBtnExitGame() {
		return this.btnExitGame;
	}

// Updates the dashboard's player status label text
	
	public void updateStatusDisplay(String text) {
		this.lblPlayerStatus.setText(text);
	}
}
